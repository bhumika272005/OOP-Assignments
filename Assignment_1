#include <iostream>
using namespace std;
class Account {
private:
    char customerName[50];
    int accountNumber;
    char accountType[20];

public:
    float balance;

    void initializeAccount() {
        cout << "Enter customer's full name: ";
        cin >> customerName;
        cout << "Enter account number: ";
        cin >> accountNumber;
        cout << "Enter starting balance: ";
        cin >> balance;
    }

    void makeDeposit() {
        float amount;
        cout << "Deposit amount: ";
        cin >> amount;
        balance += amount;
        cout << "Deposit successful.\n";
    }

    void showBalance() {
        cout << "Available balance: Rs. " << balance << endl;
    }
};

class SavingAccount : public Account {
public:
    void calculateInterest() {
        float rate, interest;
        int duration;
        cout << "Enter annual interest rate (%): ";
        cin >> rate;
        cout << "Enter time in years: ";
        cin >> duration;
        interest = (balance * rate * duration) / 100;
        balance += interest;
        cout << "Interest credited: Rs. " << interest << endl;
    }

    void makeWithdrawal() {
        float amount;
        cout << "Enter amount to withdraw: ";
        cin >> amount;
        if (amount <= balance) {
            balance -= amount;
            cout << "Amount withdrawn successfully.\n";
        } else {
            cout << "Insufficient balance!\n";
        }
    }
};

class CurrentAccount : public Account {
public:
    void makeWithdrawal() {
        float amount;
        cout << "Enter amount to withdraw: ";
        cin >> amount;
        if (amount <= balance) {
            balance -= amount;
            cout << "Withdrawal processed.\n";
        } else {
            cout << "Withdrawal failed. Not enough balance.\n";
        }
    }

    void enforceMinimumBalance() {
        if (balance < 1000) {
            cout << "Balance below minimum. A service charge of Rs. 100 has been deducted.\n";
            balance -= 100;
        }
    }
};

int main() {
    SavingAccount savings;
    CurrentAccount current;
    int choice;

    cout << "Choose Account Type:\n1. Savings Account\n2. Current Account\nYour choice: ";
    cin >> choice;

    if (choice == 1) {
        cout << "\n--- Savings Account Operations ---\n";
        savings.initializeAccount();
        savings.makeDeposit();
        savings.calculateInterest();
        savings.makeWithdrawal();
        savings.showBalance();
    } 
    else if (choice == 2) {
        cout << "\n--- Current Account Operations ---\n";
        current.initializeAccount();
        current.makeDeposit();
        current.showBalance();
        current.makeWithdrawal();
        current.showBalance();
        current.enforceMinimumBalance();
        current.showBalance();
    } 
    else {
        cout << "Invalid option selected.\n";
    }

    return 0;
}
