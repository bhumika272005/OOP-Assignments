#include <iostream>
using namespace std;

class Account {
public:
    float balance;

    void createAccount() {
        cout << "Enter starting balance: ";
        cin >> balance;
    }

    void deposit() {
        float amount;
        cout << "Enter deposit amount: ";
        cin >> amount;
        balance += amount;
        cout << "Deposit successful.\n";
    }

    void showBalance() {
        cout << "Current balance: Rs. " << balance << endl;
    }
};

class SavingsAccount : public Account {
public:
    void addInterest() {
        float rate = 4.0; // fixed interest rate for simplicity
        float interest = (balance * rate * 1) / 100; // 1 year
        balance += interest;
        cout << "Interest of Rs. " << interest << " added.\n";
    }

    void withdraw() {
        float amount;
        cout << "Enter withdrawal amount: ";
        cin >> amount;
        if (amount <= balance) {
            balance -= amount;
            cout << "Withdrawal successful.\n";
        } else {
            cout << "Not enough balance.\n";
        }
    }
};

class CurrentAccount : public Account {
public:
    void withdraw() {
        float amount;
        cout << "Enter withdrawal amount: ";
        cin >> amount;
        if (amount <= balance) {
            balance -= amount;
            cout << "Withdrawal successful.\n";
        } else {
            cout << "Insufficient balance.\n";
        }
    }

    void checkMinimumBalance() {
        if (balance < 1000) {
            cout << "Balance below Rs. 1000. Deducting Rs. 100 as penalty.\n";
            balance -= 100;
        }
    }
};

