#include <iostream>
#include <string>
using namespace std;

class Account {
private:
    string customerName;
    int accountNumber;
    string accountType;

public:
    float balance;

    Account() {
        accountNumber = 0;
        balance = 0.0f;
    }

    Account(string name, int accNo, string type, float bal) {
        customerName = name;
        accountNumber = accNo;
        accountType = type;
        balance = bal;
    }

    void getAccountDetails() {
        cout << "Enter customer name: ";
        cin >> customerName;
        cout << "Enter account number: ";
        cin >> accountNumber;
        cout << "Enter account type: ";
        cin >> accountType;
        cout << "Enter opening balance: ";
        cin >> balance;
    }

    void addDeposit() {
        float depositAmount;
        cout << "Enter amount to deposit: ";
        cin >> depositAmount;
        balance += depositAmount;
        cout << "Deposit successful!\n";
    }

    void showBalance() const {
        cout << "Current balance: Rs. " << balance << endl;
    }
};

class SavingAccount : public Account {
public:
    SavingAccount() : Account() {}
    SavingAccount(string name, int accNo, string type, float bal) : Account(name, accNo, type, bal) {}

    void applyInterest() {
        float rate;
        int years;
        cout << "Enter annual interest rate (%): ";
        cin >> rate;
        cout << "Enter duration in years: ";
        cin >> years;
        float interest = (balance * rate * years) / 100;
        balance += interest;
        cout << "Interest of Rs. " << interest << " added to your balance.\n";
    }

    void makeWithdrawal() {
        float withdrawAmount;
        cout << "Enter withdrawal amount: ";
        cin >> withdrawAmount;
        if (withdrawAmount <= balance) {
            balance -= withdrawAmount;
            cout << "Withdrawal completed successfully.\n";
        } else {
            cout << "Insufficient funds.\n";
        }
    }
};

class CurrentAccount : public Account {
public:
    CurrentAccount() : Account() {}
    CurrentAccount(string name, int accNo, string type, float bal) : Account(name, accNo, type, bal) {}

    void makeWithdrawal() {
        float withdrawAmount;
        cout << "Enter amount to withdraw: ";
        cin >> withdrawAmount;
        if (withdrawAmount <= balance) {
            balance -= withdrawAmount;
            cout << "Withdrawal processed.\n";
        } else {
            cout << "Withdrawal failed due to low balance.\n";
        }
        enforceMinBalance();
    }

    void enforceMinBalance() {
        if (balance < 1000) {
            cout << "Balance below minimum. Rs. 100 penalty applied.\n";
            balance -= 100;
        }
    }
};

int main() {
    SavingAccount savingsAcc;
    CurrentAccount currentAcc;

    int choice;
    cout << "Select Account Type:\n1. Savings Account\n2. Current Account\nYour choice: ";
    cin >> choice;

    if (choice == 1) {
        cout << "\n--- Savings Account Operations ---\n";
        savingsAcc.getAccountDetails();
        savingsAcc.addDeposit();
        savingsAcc.applyInterest();
        savingsAcc.makeWithdrawal();
        savingsAcc.showBalance();
    } else if (choice == 2) {
        cout << "\n--- Current Account Operations ---\n";
        currentAcc.getAccountDetails();
        currentAcc.addDeposit();
        currentAcc.showBalance();
        currentAcc.makeWithdrawal();
        currentAcc.showBalance();
    } else {
        cout << "Invalid option. Please restart the program.\n";
    }

    return 0;
}
