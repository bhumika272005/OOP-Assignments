#include <iostream>
using namespace std;

class Staff {
public:
    int code;
    string name;

    void getData() {
        cout << "Enter Staff Code: ";
        cin >> code;
        cin.ignore();
        cout << "Enter Staff Name: ";
        getline(cin, name);
    }

    void showData() {
        cout << "Code: " << code << ", Name: " << name << endl;
    }
};

class Teacher : public Staff {
public:
    string subject;

    void getData() {
        Staff::getData();
        cout << "Enter Subject: ";
        getline(cin, subject);
    }

    void showData() {
        Staff::showData();
        cout << "Subject: " << subject << endl;
    }
};

class Typist : public Staff {
public:
    float speed;

    void getData() {
        Staff::getData();
        cout << "Enter Typing Speed: ";
        cin >> speed;
    }

    void showData() {
        Staff::showData();
        cout << "Speed: " << speed << " wpm" << endl;
    }
};

int main() {
    Teacher t;
    Typist ty;

    cout << "Enter Teacher Details\n";
    t.getData();

    cout << "\n Enter Typist Details\n";
    ty.getData();

    cout << "\nDisplaying Details \n";
    cout << "\nTeacher:\n";
    t.showData();

    cout << "\nTypist:\n";
    ty.showData();

    return 0;
}
