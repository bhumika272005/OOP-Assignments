#include <iostream>
#include <string>
using namespace std;

class Student {
private:
    string name;
    int rollNo;
public:
    Student() {
        name = "Unknown";
        rollNo = 0;
    }

    Student(string studentkaName, int studentRollNo) {
        name = studentkaName;
        rollNo = studentRollNo;
    }

    void inputStudentDetails() {
        cout << "Enter student name: ";
        getline(cin, name);
        cout << "Enter student roll number: ";
        cin >> rollNo;
        cin.ignore();  // To clear the input buffer after taking roll number
    }

    void displayStudentDetails() {
        cout << "Student Name: " << name << endl;
        cout << "Roll Number: " << rollNo << endl;
    }
};

int main() {
    Student s1("Bhumika", 101); 
    Student s2; 
    
    cout << "Enter details for the second student:" << endl;
    s2.inputStudentDetails();

    cout << "\n--- Student 1 Details ---" << endl;
    s1.displayStudentDetails();

    cout << "\n--- Student 2 Details ---" << endl;
    s2.displayStudentDetails();

    return 0;
}
